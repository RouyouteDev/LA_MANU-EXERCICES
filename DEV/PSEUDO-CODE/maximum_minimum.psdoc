ALGORITHME / min_max_produits

VARIABLES:
    products : TABLEAU DE STRUCTURE / DICTIONNAIRE
    prix_min_actuel : REEL
    indice_min_actuel : ENTIER
    prix_max_actuel : REEL
    indice_max_actuel : ENTIER
    i : ENTIER
    produit_courant : STRUCTURE / DICTIONNAIRE

DEBUT:
    products <- [
        {"nom": "Stylo", "prix": 2.5},
        {"nom": "Cahier", "prix": 1.8},
        {"nom": "Classeur", "prix": 4.5},
        {"nom": "Gomme", "prix": 1.8},
        {"nom": "Trousse", "prix": 3.2}
    ]

    afficher(min_func(products))
    afficher(max_func(products))
FIN


// --- FONCTION MINIMUM ---
FONCTION min_func(list_product : TABLEAU) RETOURNE REEL, ENTIER
VARIABLES:
    prix_min_actuel : REEL
    indice_min_actuel : ENTIER
    i : ENTIER
    produit_courant : STRUCTURE
DEBUT:
    prix_min_actuel <- list_product[0]["prix"]
    indice_min_actuel <- 0  // Note : en Python il était initialisé à None, mais ici il prendra 0 dès la 1ère correspondance
    i <- 0

    POUR CHAQUE produit_courant DANS list_product FAIRE:
        SI produit_courant["prix"] <= prix_min_actuel ALORS:
            prix_min_actuel <- produit_courant["prix"]
            indice_min_actuel <- i
        FIN SI
        i <- i + 1
    FIN POUR

    RETOURNER prix_min_actuel, indice_min_actuel
FIN FONCTION


// --- FONCTION MAXIMUM ---
FONCTION max_func(list_product : TABLEAU) RETOURNE REEL, ENTIER
VARIABLES:
    prix_max_actuel : REEL
    indice_max_actuel : ENTIER
    i : ENTIER
    produit_courant : STRUCTURE
DEBUT:
    prix_max_actuel <- list_product[0]["prix"]
    indice_max_actuel <- 0
    i <- 0

    POUR CHAQUE produit_courant DANS list_product FAIRE:
        SI produit_courant["prix"] >= prix_max_actuel ALORS:
            prix_max_actuel <- produit_courant["prix"]
            indice_max_actuel <- i
        FIN SI
        i <- i + 1
    FIN POUR

    RETOURNER prix_max_actuel, indice_max_actuel
FIN FONCTION