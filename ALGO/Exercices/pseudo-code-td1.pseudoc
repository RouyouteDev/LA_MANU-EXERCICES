Algorithme : Calculateur billet SNCF

Variables
    age : ENTIER
    a_carte_reduction : BOOLEEN
    prix : REEL
CONSTANTES
    PRIX_BASE = 100.0

DEBUT
    AFFICHER(Bonjour ! Entrez l'âge du voyageur)
    CHOIX(age)

    AFFICHER("Le voyageur possède-t-il une carte de réduction (VRAI/FAUX)")
    CHOIX(a_carte_reduction)

    si age < 12 alors
        prix <- 0.0
    sinon si age >= 12 ET age <= 25 alors
        prix <- PRIX_BASE * 0.50

        si a_carte_reduction alors
            prix <- prix * 0.90
        fin_si
    sinon
        prix <- PRIX_BASE

        si a_carte_reduction alors
            prix <- prix * 0.80
        fin_si

    AFFICHER("Le prix final du billet est de : ",prix,"€")
fin